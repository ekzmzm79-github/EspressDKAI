{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day.schema.json",
  "title": "하루치 브리핑 (data/days/YYYY-MM-DD.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "headline", "items"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "headline": {
      "description": "오늘의 한 줄. 가장 중요한 항목 하나를 가리킨다",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "text"],
      "properties": {
        "item_id": { "$ref": "#/$defs/item_id" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "event_key", "title", "card", "detail", "sources", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/item_id" },
        "section": { "enum": ["llm", "hiring"] },
        "event_key": { "description": "무슨 일인가를 한 줄로. 중복 판단용", "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "card": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "detail": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "published"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/$defs/url" },
              "published": { "type": "string", "format": "date" }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "edits"],
          "properties": {
            "status": { "enum": ["pass", "fixed"] },
            "edits": { "type": "integer", "minimum": 0 },
            "note": { "type": "string" }
          }
        },
        "hiring": { "$ref": "#/$defs/hiring" },
        "window_exception": { "description": "사람이 수집 기간 밖 항목을 올리기로 정한 이유. 있으면 발행일 기간 검사를 건너뛴다", "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "section": { "const": "hiring" } } },
      "then": { "required": ["hiring"] },
      "else": { "not": { "required": ["hiring"] } }
    },
    "hiring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "type", "targets", "eligibility", "deadline"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "type": { "enum": ["AI 과제", "AI 면접", "해커톤", "공모전", "인재육성", "기타"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["신입", "경력", "청년"] }
        },
        "eligibility": { "description": "참가 자격 요점 한 줄", "type": "string", "minLength": 1 },
        "apply_start": { "type": "string", "format": "date" },
        "deadline": { "type": "string", "format": "date" },
        "benefit": { "type": "string" }
      }
    }
  }
}
