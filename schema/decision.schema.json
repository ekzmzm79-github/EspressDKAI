{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "사람 결정 기록 (data/decisions/YYYY-MM-DD-<n>.json). Actions만 쓴다",
  "type": "object",
  "additionalProperties": false,
  "required": ["decided_at", "via", "items"],
  "properties": {
    "decided_at": { "type": "string", "format": "date-time" },
    "via": { "enum": ["drop", "pr-closed"] },
    "pr": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "status", "event_key", "url"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}$" },
          "status": { "const": "rejected" },
          "event_key": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://\\S+$" }
        }
      }
    }
  }
}
